.PD
[\f[B]\-S\f[R] \f[I]dir\f[R]] [\f[B]\-D\f[R] \f[I]dir\f[R]]
[\f[B]\-X\f[R]]
.PD 0
.P
.PD
[\f[B]\-W\f[R]\f[I]debug\-\f[R]\&...]
[\f[B]\-f\f[R]\f[I]option\f[R]] [\f[B]\-gen\-\f[R]\f[I]option\f[R]]
[\f[B]\-pdu\f[R]={\f[B]all\f[R]|\f[B]auto\f[R]|\f[I]Type\f[R]}]
