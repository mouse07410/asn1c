include Makefile.am.libasncodec

bin_PROGRAMS += asn1convert
asn1convert_CFLAGS = $(ASN_MODULE_CFLAGS) -DPDU=EndApplicationMessage 
asn1convert_CPPFLAGS = -I$(top_srcdir)/
asn1convert_LDADD = libasncodec.la
asn1convert_SOURCES = \
	converter-example.c
regen: regenerate-from-asn1-source

regenerate-from-asn1-source:
	/home/runner/work/asn1c/asn1c/asn1c/asn1c -fall-defs-global -fcompound-names -fincludes-quoted -fline-refs -fwide-types -pdu=EndApplicationMessage C2X.asn

