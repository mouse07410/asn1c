	(ASN_TAG_CLASS_UNIVERSAL | (4 << 2))
};

/* Custom XER encoder per ENCODING-CONTROL directive */
static asn_enc_rval_t
HexData_encode_xer(const asn_TYPE_descriptor_t *td, const void *sptr,
	int ilevel, enum xer_encoder_flags_e flags,
	asn_app_consume_bytes_f *cb, void *app_key) {
	const OCTET_STRING_t *st = (const OCTET_STRING_t *)sptr;
	asn_enc_rval_t er = {0,0,0};
	
	(void)td;  /* Unused parameter */
	(void)ilevel;  /* Unused in this implementation */
	(void)flags;  /* Unused in this implementation */
	
	if(!st || (!st->buf && st->size)) {
		ASN__ENCODE_FAILED;
	}
	
	/* Hexadecimal encoding per ENCODING-CONTROL */
	{
		const char * const h2c = "0123456789ABCDEF";
		char *hexbuf;
		size_t i;
		
		hexbuf = (char *)MALLOC(st->size * 2 + 1);
		if(!hexbuf) ASN__ENCODE_FAILED;
		
		for(i = 0; i < st->size; i++) {
			hexbuf[i*2] = h2c[(st->buf[i] >> 4) & 0x0F];
			hexbuf[i*2 + 1] = h2c[st->buf[i] & 0x0F];
		}
		hexbuf[st->size * 2] = 0;
		
		er.encoded = cb(hexbuf, st->size * 2, app_key);
		FREEMEM(hexbuf);
		if(er.encoded < 0) ASN__ENCODE_FAILED;
	}
	
	return er;
}


/* Custom XER decoder per ENCODING-CONTROL directive */
static asn_dec_rval_t
HexData_decode_xer(const asn_codec_ctx_t *opt_codec_ctx,
	const asn_TYPE_descriptor_t *td, void **sptr,
	const char *opt_mname, const void *buf_ptr, size_t size) {
	/* Hexadecimal decoding per ENCODING-CONTROL */
	return OCTET_STRING_decode_xer_hex(opt_codec_ctx, td, sptr,
		opt_mname, buf_ptr, size);
}

