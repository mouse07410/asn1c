/* Custom XER encoder per ENCODING-CONTROL directive */
static asn_enc_rval_t
payload_encode_xer(const asn_TYPE_descriptor_t *td, const void *sptr,
	int ilevel, enum xer_encoder_flags_e flags,
	asn_app_consume_bytes_f *cb, void *app_key) {
	/* Base64 encoding per ENCODING-CONTROL XER ... ::= base64 */
	return OCTET_STRING_encode_xer_base64(td, sptr, ilevel, flags, cb, app_key);
}


/* Custom XER decoder per ENCODING-CONTROL directive */
static asn_dec_rval_t
payload_decode_xer(const asn_codec_ctx_t *opt_codec_ctx,
	const asn_TYPE_descriptor_t *td, void **sptr,
	const char *opt_mname, const void *buf_ptr, size_t size) {
	/* Base64 decoder pinned per ENCODING-CONTROL */
	return OCTET_STRING_decode_xer_base64(opt_codec_ctx, td, sptr,
		opt_mname, buf_ptr, size);
}

